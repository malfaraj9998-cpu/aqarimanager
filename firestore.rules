rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Super admin emails — keep in sync with AuthContext.jsx
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'malfaraj9998@gmail.com' ||
        request.auth.token.email == 'alfaraj1412@gmail.com'
      );
    }

    match /users/{userId} {
      // Super admin can read/write anyone's user profile (for admin panel).
      // Regular users can only read/write their own profile.
      allow read, write: if isSuperAdmin() || (request.auth != null && request.auth.uid == userId);
      
      // Private data sub-collections (buildings, contracts, clients, finance)
      // are strictly isolated: only the owning user can access their own data.
      match /{collection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
